{
  "meta": {
    "name": "ChapelCloud",
    "domain": "chapel.cloud",
    "concept": "covering-presence",
    "updated": "2026-08-05"
  },
  "fonts": {
    "display": "Newsreader",
    "sans": "Source Sans 3",
    "fallbacks": {
      "display": ["Georgia", "Times New Roman", "serif"],
      "sans": ["ui-sans-serif", "system-ui", "sans-serif"]
    }
  },
  "colors": {
    "ink": {
      "hex": "#121820",
      "role": "Primary text — night before the pillar of fire"
    },
    "inkMuted": {
      "hex": "#5c6672",
      "role": "Secondary text"
    },
    "cloud": {
      "hex": "#f3f5f7",
      "role": "Light surfaces — covering mist"
    },
    "mist": {
      "hex": "#e6eaef",
      "role": "Soft panels and atmospheric bands"
    },
    "stone": {
      "hex": "#b4bec9",
      "role": "Borders, dividers, quiet structure"
    },
    "presence": {
      "hex": "#2a4054",
      "role": "Brand primary — sanctuary slate / dusk cloud"
    },
    "presenceDeep": {
      "hex": "#1a2b3a",
      "role": "Deep brand, hover, dark chrome"
    },
    "covering": {
      "hex": "#7a94a8",
      "role": "Mid cloud — icons, secondary UI, illustrations"
    },
    "witness": {
      "hex": "#b8923f",
      "role": "Accent — light that shines (use sparingly)"
    },
    "witnessSoft": {
      "hex": "#e8d4a8",
      "role": "Soft amber wash for focus / highlight"
    }
  },
  "semantic": {
    "brand": "presence",
    "brandHover": "presenceDeep",
    "accent": "witness",
    "background": "cloud",
    "surface": "mist",
    "border": "stone",
    "text": "ink",
    "textMuted": "inkMuted"
  }
}
